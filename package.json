{
  "name": "voyage-de-venus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Le Voyage de Vénus — cycle synodique de 584 jours, portails d'Inanna et chakras",
  "scripts": {
    "dev": "vite dev --port 5180",
    "build": "vite build",
    "preview": "vite preview --port 4180",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler pages deploy build --project-name voyage-de-venus --branch main --commit-dirty=true",
    "preview:pages": "npm run build && wrangler pages dev build --project-name voyage-de-venus"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "happy-dom": "^21.0.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://voyage-de-venus.pages.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/leocrapart-pixel/voyage-de-venus.git"
  }
}
